# =============================================================================
# ardouraAI -- Environment Variables Template
#
# Copy this file to .env and fill in your values.
#   cp .env.template .env    (Linux/Mac)
#   copy .env.template .env  (Windows)
#
# NEVER commit .env to source control -- it contains secrets.
# .env is already listed in .gitignore.
# =============================================================================

# -- Anthropic ----------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-api03-YOUR_KEY_HERE

# -- GitHub -------------------------------------------------------------------
# Personal Access Token -- classic token with 'repo' scope
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=github_pat_YOUR_TOKEN_HERE

# APPLICATION repo the agent acts ON (not the ardouraAI agent repo itself)
APP_GITHUB_OWNER=your-github-username
APP_GITHUB_REPO=your-app-repo
APP_GITHUB_BRANCH=main

# -- Atlassian / Jira / Confluence --------------------------------------------
ATLASSIAN_BASE=https://your-org.atlassian.net
ATLASSIAN_EMAIL=you@your-org.com
ATLASSIAN_API_TOKEN=ATATT3x_YOUR_TOKEN_HERE

# Jira project keys
JIRA_SOURCE_PROJECT_KEY=ADEV      # new tickets here trigger the AI agent
JIRA_ACTION_PROJECT_KEY=ACR       # AI agent creates approval tickets here

# Confluence page IDs (found in the page URL: /wiki/spaces/.../pages/PAGE_ID)
CONFLUENCE_DOC_PAGE_ID=0000000
CONFLUENCE_TROUBLESHOOT_PAGE_ID=0000000

# Confluence space key (e.g. ~userid or TEAM)
CONFLUENCE_SPACE_KEY=~your-confluence-space-key

# Optional: page titles used when publishing generated docs
CONFLUENCE_DOC_PAGE_TITLE=Your App Documentation
CONFLUENCE_TROUBLESHOOT_PAGE_TITLE=Your App Troubleshooting Guide
CONFLUENCE_BASE_URL=https://your-org.atlassian.net/wiki

# -- Kafka --------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=jira-events
KAFKA_GROUP_ID=jira-agent-group
KAFKA_TARGET_PROJECT_KEY=ADEV
KAFKA_TARGET_WEBHOOK_EVENT=jira:issue_created

# -- Flask webhook server -----------------------------------------------------
FLASK_PORT=5000

# -- Application MySQL Database -----------------------------------------------
# Leave all DB_* blank to disable DB features
DB_HOST=your-mysql-host
DB_PORT=3306
DB_NAME=your-database-name
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_ALLOW_DESTRUCTIVE=false

# -- Observability Tools (ALL OPTIONAL -- missing = tool gracefully skipped) --

# Dynatrace
# Token scopes needed: problems.read, events.read
# Generate at: https://YOUR_ENV.live.dynatrace.com/ui/access-tokens
DYNATRACE_URL=https://YOUR_ENV_ID.live.dynatrace.com
DYNATRACE_API_TOKEN=dt0c01.YOUR_TOKEN_HERE

# Datadog
# Generate at: https://app.datadoghq.com/organization-settings/api-keys
DATADOG_API_KEY=YOUR_DATADOG_API_KEY
DATADOG_APP_KEY=YOUR_DATADOG_APP_KEY
DATADOG_SITE=datadoghq.com

# Grafana
# Generate service account token: Grafana -> Administration -> Service accounts
GRAFANA_URL=http://localhost:3000
GRAFANA_API_KEY=YOUR_GRAFANA_SERVICE_ACCOUNT_TOKEN

# Prometheus (no auth needed for local instances)
PROMETHEUS_URL=http://localhost:9090

# -- Observability severity thresholds ----------------------------------------
# Alerts below these levels are silently ignored. Leave blank to forward ALL.
#
# Dynatrace levels (low->high): RESOURCE, PERFORMANCE, ERROR, AVAILABILITY
DYNATRACE_MIN_SEVERITY=ERROR

# Datadog levels (low->high): info, warning, error, critical
DATADOG_MIN_SEVERITY=error

# Grafana levels (low->high): info, warning, critical
GRAFANA_MIN_SEVERITY=warning
