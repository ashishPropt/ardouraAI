# =============================================================================
# ArdouraAI Tenant Secrets Template
# =============================================================================
# Fill in all values for your tenant and provide this file to the
# ArdouraAI onboarding team. The file will be encrypted and stored
# securely. The plain-text version should be deleted after onboarding.
#
# NEVER commit this file to git.
# =============================================================================

# --- Anthropic (required) ---
ANTHROPIC_API_KEY=

# --- Atlassian Jira + Confluence (required if using Jira/Confluence) ---
ATLASSIAN_BASE=https://yourorg.atlassian.net
ATLASSIAN_EMAIL=your@email.com
ATLASSIAN_API_TOKEN=
JIRA_SOURCE_PROJECT_KEY=ADEV
JIRA_ACTION_PROJECT_KEY=ACR
CONFLUENCE_DOC_PAGE_ID=
CONFLUENCE_TROUBLESHOOT_PAGE_ID=
CONFLUENCE_SPACE_KEY=
CONFLUENCE_BASE_URL=https://yourorg.atlassian.net/wiki
JIRA_ASSIGNEE_ACCOUNT_ID=

# --- GitHub (required if using GitHub integration) ---
GITHUB_TOKEN=
APP_GITHUB_OWNER=
APP_GITHUB_REPO=
APP_GITHUB_BRANCH=main

# --- Kafka (set automatically by platform, do not change) ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=jira-events
KAFKA_GROUP_ID=
KAFKA_TARGET_PROJECT_KEY=
KAFKA_TARGET_WEBHOOK_EVENT=jira:issue_created

# --- Observability (optional - fill in what you use) ---
DYNATRACE_URL=
DYNATRACE_API_TOKEN=
DATADOG_API_KEY=
DATADOG_APP_KEY=
DATADOG_SITE=datadoghq.com
GRAFANA_URL=
GRAFANA_API_KEY=
PROMETHEUS_URL=
